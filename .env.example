# ===========================================
# DICE Scholarship Exam - Environment Variables
# ===========================================

# GEMINI_API_KEY (Required for AI features)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ADMIN_SECRET (Highly Recommended for production)
# Strong password for Examiner / Admin login.
# If not set, a default is used (change this in production!)
ADMIN_SECRET="change_this_to_a_very_strong_password"

# APP_URL (Optional)
# Public URL of the deployed app
APP_URL="https://your-app.vercel.app"
