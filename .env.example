# ===========================================
# DICE Scholarship Exam - Environment Variables
# ===========================================

# GEMINI_API_KEY: Required for AI evaluation & Co-pilot features.
# Get it from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public URL where this app is hosted (used by Vercel / production).
APP_URL="https://your-app.vercel.app"

# ADMIN_SECRET (Optional): Master key for Examiner/Admin login.
# If not set, the default key will be used for backward compatibility.
# ADMIN_SECRET="your_strong_admin_password"
